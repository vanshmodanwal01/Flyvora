# --- PostgreSQL (used by docker-compose to init the db container) ---
POSTGRES_USER=flyvora
POSTGRES_PASSWORD=flyvora_dev_password
POSTGRES_DB=flyvora

# --- Backend ---
# Inside Docker Compose, host "db" resolves to the postgres container.
DATABASE_URL=postgresql+psycopg2://flyvora:flyvora_dev_password@db:5432/flyvora

# Comma-separated list of origins allowed to call the API.
# Add your GitHub Pages URL here once you know it, e.g. https://pranavui3.github.io
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500

ENVIRONMENT=development
